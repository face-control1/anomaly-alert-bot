# Скопируйте этот файл в .env и заполните значения

# Токен бота (получите у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID администраторов через запятую (узнайте свой ID у @userinfobot)
ADMIN_IDS=123456789,987654321

# Цена подписки в Telegram Stars (1 Star ≈ 0.013 USD)
# 250 Stars ≈ $3.25/мес
SUBSCRIPTION_PRICE_STARS=250

# Интервал опроса биржи в секундах (рекомендуется не менее 60)
POLL_INTERVAL_SEC=60

# Пороги аномалий
VOLUME_SPIKE_MULTIPLIER=3.0
PRICE_CHANGE_THRESHOLD_PCT=3.0
VOLATILITY_SIGMA=2.5

# База данных
DB_PATH=data/bot.db

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
